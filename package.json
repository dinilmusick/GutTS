{
  "name": "@dinilmusick/gutts",
  "version": "2.0.2",
  "private": false,
  "description": "Global Utilities for TypeScript applications.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./browser": "./dist/browser.js",
    "./json": "./dist/json/json-concepts.js",
    "./strings": "./dist/strings/string-concepts.js",
    "./arrays": "./dist/arrays/array-concepts.js",
    "./objects": "./dist/objects/object-concepts.js",
    "./numbers": "./dist/numbers/number-concepts.js",
    "./urls": "./dist/urls/url-concepts.js",
    "./api": "./dist/api/index.js",
    "./models": "./dist/models/index.js",
    "./semantic-input": "./dist/semantic-input/index.js",
    "./gutts.manifest.json": "./gutts.manifest.json",
    "./engineering": "./dist/engineering/index.js",
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "import": "./dist/auth/index.js",
      "default": "./dist/auth/index.js"
    },
    "./storage": "./dist/storage/index.js",
    "./server": "./dist/server/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "pnpm run build",
    "prepare": "pnpm run build",
    "boundary": "node scripts/architecture-boundary.mjs"
  },
  "dependencies": {
    "lodash-es": "^4.17.21",
    "validator": "^13.15.15"
  },
  "peerDependencies": {
    "@aws-sdk/client-s3": "^3.1164.0",
    "googleapis": "^189.0.0",
    "@huggingface/transformers": "^4.3.2",
    "cactus-needle": "^0.3.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-s3": {
      "optional": true
    },
    "googleapis": {
      "optional": true
    },
    "@huggingface/transformers": {
      "optional": true
    },
    "cactus-needle": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1164.0",
    "@types/lodash-es": "^4.17.12",
    "@types/validator": "^13.12.2",
    "googleapis": "^189.0.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "@huggingface/transformers": "^4.3.2",
    "cactus-needle": "^0.3.0"
  },
  "files": [
    "dist",
    "README.md",
    "gutts.manifest.json",
    ".krusbl-release-attestation.json"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "pnpm@10.33.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dinilmusick/GutTS.git"
  },
  "license": "MIT"
}
