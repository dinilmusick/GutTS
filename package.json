{
  "name": "@dinilmusick/gutts",
  "version": "1.3.2",
  "private": false,
  "description": "Global Utilities for TypeScript applications.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./json": "./dist/json/json-concepts.js",
    "./strings": "./dist/strings/string-concepts.js",
    "./arrays": "./dist/arrays/array-concepts.js",
    "./objects": "./dist/objects/object-concepts.js",
    "./numbers": "./dist/numbers/number-concepts.js",
    "./urls": "./dist/urls/url-concepts.js",
    "./api": "./dist/api/index.js",
    "./models": "./dist/models/index.js",
    "./semantic-input": "./dist/semantic-input/index.js",
    "./gutts.manifest.json": "./gutts.manifest.json",
    "./engineering": "./dist/engineering/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "cactus-needle": "^0.3.0",
    "lodash-es": "^4.17.21",
    "validator": "^13.15.15"
  },
  "pnpm": {
    "overrides": {
      "onnxruntime-node": "1.20.1"
    },
    "onlyBuiltDependencies": [
      "onnxruntime-node",
      "protobufjs"
    ]
  },
  "devDependencies": {
    "@types/lodash-es": "^4.17.12",
    "@types/validator": "^13.12.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "files": [
    "dist",
    "README.md",
    "gutts.manifest.json",
    ".krusbl-release-attestation.json"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "pnpm@10.33.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dinilmusick/GutTS.git"
  },
  "license": "MIT"
}
