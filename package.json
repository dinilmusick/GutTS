{
  "name": "@dinilmusick/gutts",
  "version": "0.1.3",
  "private": false,
  "description": "Global Utilities for TypeScript applications.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./json": "./dist/json/json-concepts.js",
    "./strings": "./dist/strings/string-concepts.js",
    "./arrays": "./dist/arrays/array-concepts.js",
    "./objects": "./dist/objects/object-concepts.js",
    "./numbers": "./dist/numbers/number-concepts.js",
    "./urls": "./dist/urls/url-concepts.js",
    "./gutts.manifest.json": "./gutts.manifest.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "lodash-es": "^4.17.21",
    "validator": "^13.15.15"
  },
  "devDependencies": {
    "@types/lodash-es": "^4.17.12",
    "@types/validator": "^13.12.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "files": [
    "dist",
    "README.md",
    "gutts.manifest.json",
    ".krusbl-release-attestation.json"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "pnpm@10.33.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dinilmusick/GutTS.git"
  },
  "license": "MIT"
}
